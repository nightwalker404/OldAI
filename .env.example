### Redis Configuration ###
RedisPort=6379
RedisHost=localhost
RedisSession=DefaultSession
RedisPassword=your-strong-password-here

### VLLM Configuration ###
VLLM_PORT=8000
VLLM_BASE_URL=http://localhost:8000
VLLM_TIMEOUT=60s
VLLM_MODELS=Qwen/Qwen2.5-0.5B-Instruct,Qwen/Qwen2.5-1.5B-Instruct
VLLM_GPU_MEMORY_UTILIZATION=0.8
VLLM_MAX_MODEL_LEN=1024